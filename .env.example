# TypeSafe AI Jev Decision Model (supports OpenRouter gateway or official TypeSafe endpoint)
# Official TypeSafe API alternative: https://api.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-latest

# OpenAI-compatible text models (overview generator + Evidence-First Judge)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OVERVIEW_MODEL=google/gemini-2.5-flash-lite
JUDGE_MODEL=anthropic/claude-sonnet-4
